{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.78", "--browser", "chromium"],
      "env": {}
    },
    "stripe": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@stripe/mcp@0.3.3"],
      "env": {
        "STRIPE_SECRET_KEY": "${STRIPE_MCP_RESTRICTED_KEY}"
      }
    }
  }
}
